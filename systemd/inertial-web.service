[Unit]
Description=Inertial Computer Web Dashboard
After=network-online.target mosquitto.service
Wants=network-online.target
PartOf=inertial.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=@USER@
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/bin/web
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=inertial.target
