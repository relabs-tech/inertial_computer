[Unit]
Description=Inertial Computer GPS Producer
After=network-online.target mosquitto.service
Wants=network-online.target
PartOf=inertial.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=root
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/bin/gps_producer
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=inertial.target
