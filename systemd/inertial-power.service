[Unit]
Description=Inertial Computer Power/UPS Producer (PiSugar 3)
After=network-online.target mosquitto.service
Wants=network-online.target
PartOf=inertial.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
User=root
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/power_producer
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=inertial.target
